    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const xml = item.json.xml || item.json.signed_xml;\n\n  if (!xml) {\n    throw new Error(\n      \"XML signé introuvable. Champs disponibles: \" +\n      JSON.stringify(Object.keys(item.json))\n    );\n  }\n\n  const match = xml.match(/<DocumentIdentifier>(.*?)<\\/DocumentIdentifier>/);\n\n  if (!match || !match[1]) {\n    throw new Error(\"Numéro de facture introuvable dans DocumentIdentifier\");\n  }\n\n  const invoiceNumber = match[1]\n    .trim()\n    .replace(/[\\\\/:*?\"<>|]/g, \"_\");\n\n  const fileName = `${invoiceNumber}_signed.xml`;\n\n  item.json.file_name = fileName;\n  item.json.invoice_number = invoiceNumber;\n\n  item.binary = {\n    data: {\n      data: Buffer.from(xml, 'utf8').toString('base64'),\n      mimeType: 'application/xml',\n      fileName: fileName\n    }\n  };\n\n  return item;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
